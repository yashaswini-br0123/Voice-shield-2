# VoiceShield Configuration

# Operational Mode
# Set DEMO_MODE=true for interactive presentation mode without full ML models loaded
DEMO_MODE=true

# Server Config
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=["*"]

# Model Paths
AASIST_CHECKPOINT_PATH=model_weights/aasist.pth
SPECTRAL_MODEL_PATH=model_weights/spectral_clf.joblib

# Optional Multimodal / External API key (Layer 1 optional enhancement)
GEMINI_API_KEY=

# Detection Thresholds
HUMAN_THRESHOLD=0.35
AI_THRESHOLD=0.65

# Ensemble Weights (must sum to 1.0 ideally, dynamically normalized)
LAYER1_ACOUSTIC_WEIGHT=0.30
LAYER2_WAVEFORM_WEIGHT=0.40
LAYER3_SPECTRAL_WEIGHT=0.30

# File Upload Constraints
MAX_FILE_SIZE_MB=15
MAX_AUDIO_DURATION_SEC=120
MIN_AUDIO_DURATION_SEC=0.5
ALLOWED_EXTENSIONS=["wav", "mp3", "m4a", "flac", "ogg", "webm", "aac"]
